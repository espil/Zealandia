{
  "name": "zealandia-pc",
  "version": "0.1.0",
  "private": true,
  "description": "Espil Online: A to Zealandia - PC program (Electron shell over the app payload)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "online.espil.zealandia",
    "productName": "Espil Online - A to Zealandia",
    "files": ["main.js", "server.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www" }],
    "win": { "target": ["portable"] },
    "directories": { "output": "dist" }
  }
}
